# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (R2 > Manage API Tokens)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=accra-rentals-media
# Public URL for serving files — either the R2.dev dev URL or your connected custom domain
R2_PUBLIC_URL=https://media.yourapp.com

# Hubtel (Settings > API in unity.hubtel.com — create a Receive Money POS account)
HUBTEL_CLIENT_ID=your-hubtel-client-id
HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
HUBTEL_POS_SALES_ID=your-hubtel-pos-sales-id

# Your deployed app's base URL, used to build the Hubtel callback URL.
# Use http://localhost:3000 locally, but note Hubtel can't reach localhost —
# use a tunnel (ngrok, cloudflared) if you need to test real callbacks before deploying.
APP_BASE_URL=https://your-app.vercel.app

# Arkesel (arkesel.com dashboard > API — must be your Main API key, not a scoped/sub key,
# since the OTP endpoints reject scoped keys)
ARKESEL_API_KEY=your-arkesel-main-api-key
# The sender name recipients see (e.g. "AccraRent"). Must be registered and
# approved in your Arkesel dashboard before it works — see README for setup.
ARKESEL_SENDER_ID=your-registered-sender-id

# Admin allowlist — comma-separated. Anyone whose verified phone or account
# email matches gets auto-promoted to admin (is_admin=true in the DB) the
# first time they visit /admin or verify their phone. Never NEXT_PUBLIC —
# these must stay server-only.
ADMIN_PHONES=+233241234567,+233201234567
ADMIN_EMAILS=you@example.com
# Optional bootstrap path: any logged-in user who enters this password at
# /admin/claim becomes an admin. Leave unset to disable this entirely.
# Use a long random value, not a real word — treat it like a master key.
ADMIN_PASSWORD=
